# Application
APP_ENV=development
APP_NAME=global-news-digest
APP_TIMEZONE=Asia/Shanghai
APP_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://news_user:change_me@localhost:5432/global_news

# Authentication
JWT_SECRET=change_me
JWT_EXPIRE_MINUTES=1440

# AI provider abstraction
LLM_PROVIDER=openai
LLM_API_KEY=change_me
LLM_MODEL=change_me

# Optional cache/queue
REDIS_URL=redis://localhost:6379/0

# Future notification channels (V1.0 unused)
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# GitHub CLI/API authentication (local machine environment only; do not put the real value here)
GH_TOKEN=
